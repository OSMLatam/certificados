generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  draft
  active
}

enum CertificateStatus {
  pending
  issued
  failed
  revoked
}

enum CertificateMode {
  generated
  pregenerated
}

enum AdminRole {
  admin
  editor
}

enum DocNormalize {
  digits
  alnum
  raw
}

enum BadgeType {
  event_role
  osm_activity

  @@map("badge_type")
}

enum BadgeExternalSource {
  manual_import
  osm_api
  certificate_sync
  custom

  @@map("badge_external_source")
}

enum BadgeStatus {
  pending
  issued
  revoked

  @@map("badge_status")
}

model CountryIdentityConfig {
  id              String       @id @default(uuid()) @db.Uuid
  countryCode     String       @map("country_code") @db.Char(2)
  docTypeCode     String       @map("doc_type_code") @db.VarChar(10)
  docTypeLabel    String       @map("doc_type_label") @db.VarChar(100)
  normalize       DocNormalize
  validationRegex String?      @map("validation_regex") @db.VarChar(255)
  displayOrder    Int          @map("display_order")

  @@unique([countryCode, docTypeCode])
  @@map("country_identity_config")
}

model Role {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique @db.VarChar(50)
  label        String  @db.VarChar(100)
  displayOrder Int     @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  @@map("roles")
}

model AdminUser {
  id          String    @id @default(uuid()) @db.Uuid
  osmId       BigInt    @unique @map("osm_id")
  osmUsername String    @map("osm_username") @db.VarChar(255)
  role        AdminRole?
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions       AdminSession[]
  eventsCreated  Event[]        @relation("EventCreatedBy")
  filesUploaded  StoredFile[]
  auditEntries   AuditLog[]
  erasedPeople   Participant[]  @relation("ParticipantErasedBy")
  legalUpdates   InstanceLegal[] @relation("LegalUpdatedBy")

  @@map("admin_users")
}

model AdminSession {
  id          String   @id @db.VarChar(64)
  adminUserId String   @map("admin_user_id") @db.Uuid
  data        Json     @default("{}")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

model Event {
  id                 String      @id @default(uuid()) @db.Uuid
  name               String      @db.VarChar(255)
  year               Int
  startDate          DateTime    @map("start_date") @db.Date
  endDate            DateTime?   @map("end_date") @db.Date
  countryCode        String      @map("country_code") @db.Char(2)
  allowedRoles       Json        @map("allowed_roles")
  status             EventStatus @default(draft)
  pregeneratedOnly   Boolean     @default(false) @map("pregenerated_only")
  defaultTemplateId  String?     @map("default_template_id") @db.Uuid
  createdById        String      @map("created_by") @db.Uuid
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy       AdminUser             @relation("EventCreatedBy", fields: [createdById], references: [id])
  defaultTemplate CertificateTemplate?  @relation("EventDefaultTemplate", fields: [defaultTemplateId], references: [id])
  venues          Venue[]
  participants    Participant[]
  templates       CertificateTemplate[] @relation("EventTemplates")
  certificates    Certificate[]
  badgeClasses    BadgeClass[]

  @@index([status])
  @@map("events")
}

model Venue {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  name      String    @db.VarChar(255)
  code      String    @db.VarChar(20)
  eventDate DateTime? @map("event_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  event        Event         @relation(fields: [eventId], references: [id])
  participants Participant[]
  certificates Certificate[]

  @@unique([eventId, code])
  @@map("venues")
}

model Participant {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  venueId       String?   @map("venue_id") @db.Uuid
  fullName      String    @map("full_name") @db.VarChar(255)
  /// Null when the person is identified only by document. Unique with event_id when present; NULL does not collide with NULL.
  email         String?   @db.VarChar(255)
  countryCode   String?   @map("country_code") @db.Char(2)
  docTypeCode   String?   @map("doc_type_code") @db.VarChar(10)
  docNumber     String?   @map("doc_number") @db.VarChar(100)
  activityTitle String?   @map("activity_title")
  erasedAt      DateTime? @map("erased_at") @db.Timestamptz(6)
  erasedById    String?   @map("erased_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  event        Event         @relation(fields: [eventId], references: [id])
  venue        Venue?        @relation(fields: [venueId], references: [id])
  erasedBy     AdminUser?    @relation("ParticipantErasedBy", fields: [erasedById], references: [id])
  certificates Certificate[]

  @@unique([eventId, email])
  @@index([eventId, countryCode, docTypeCode, docNumber])
  @@map("participants")
}

model StoredFile {
  id             String   @id @default(uuid()) @db.Uuid
  storageKey     String   @map("storage_key") @db.VarChar(500)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  byteSize       BigInt   @map("byte_size")
  checksumSha256 String   @map("checksum_sha256") @db.Char(64)
  uploadedById   String?  @map("uploaded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploadedBy   AdminUser?             @relation(fields: [uploadedById], references: [id])
  backgrounds  CertificateTemplate[]
  certificates Certificate[]

  @@map("stored_files")
}

model CertificateTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  roleCode         String?  @map("role_code") @db.VarChar(50)
  name             String   @db.VarChar(255)
  backgroundFileId String?  @map("background_file_id") @db.Uuid
  layout           Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event            Event         @relation("EventTemplates", fields: [eventId], references: [id])
  backgroundFile   StoredFile?   @relation(fields: [backgroundFileId], references: [id])
  defaultForEvents Event[]       @relation("EventDefaultTemplate")
  certificates     Certificate[]

  @@index([eventId])
  @@map("certificate_templates")
}

model Certificate {
  id                 String            @id @default(uuid()) @db.Uuid
  slug               String            @unique @db.VarChar(16)
  participantId      String            @map("participant_id") @db.Uuid
  eventId            String            @map("event_id") @db.Uuid
  venueId            String?           @map("venue_id") @db.Uuid
  roleCode           String            @map("role_code") @db.VarChar(50)
  mode               CertificateMode
  templateId         String?           @map("template_id") @db.Uuid
  storedFileId       String?           @map("stored_file_id") @db.Uuid
  activityTitle      String?           @map("activity_title")
  /// Normalized activity_title. Empty when this certificate has no activity of its own.
  activityKey        String            @default("") @map("activity_key")
  status             CertificateStatus @default(pending)
  issueAttempts      Int               @default(0) @map("issue_attempts")
  lastIssueError     String?           @map("last_issue_error")
  lastIssueAttemptAt DateTime?         @map("last_issue_attempt_at") @db.Timestamptz(6)
  issuedAt           DateTime?         @map("issued_at") @db.Timestamptz(6)
  /// Reserved for AC3 (Fase 2). Always null on osm.lat.
  folio              Int?
  revokedAt          DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokeReason       String?           @map("revoke_reason")
  /// Copied at issue time on AC3 (Fase 2). Always null on osm.lat.
  legalSnapshot      Json?             @map("legal_snapshot")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  participant Participant          @relation(fields: [participantId], references: [id])
  event       Event                @relation(fields: [eventId], references: [id])
  venue       Venue?               @relation(fields: [venueId], references: [id])
  template    CertificateTemplate? @relation(fields: [templateId], references: [id])
  storedFile  StoredFile?          @relation(fields: [storedFileId], references: [id])
  accessLogs     PermalinkAccessLog[]
  badgeAssertion BadgeAssertion?

  @@index([eventId, status])
  @@map("certificates")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String?  @map("admin_user_id") @db.Uuid
  action      String   @db.VarChar(50)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  ipAddress   String?  @map("ip_address") @db.Inet
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model PermalinkAccessLog {
  id            String   @id @default(uuid()) @db.Uuid
  certificateId String   @map("certificate_id") @db.Uuid
  accessedAt    DateTime @default(now()) @map("accessed_at") @db.Timestamptz(6)
  referer       String?  @db.VarChar(500)
  userAgent     String?  @map("user_agent")

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([accessedAt])
  @@index([certificateId])
  @@map("permalink_access_log")
}

/// One issuer per instance. public_key stays empty until Open Badges 3.0.
model BadgeIssuer {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(255)
  url              String   @db.VarChar(500)
  email            String?  @db.VarChar(255)
  description      String?
  imageStorageKey  String?  @map("image_storage_key") @db.VarChar(500)
  publicKey        String?  @map("public_key")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("badge_issuers")
}

model BadgeClass {
  id                String              @id @default(uuid()) @db.Uuid
  code              String              @unique @db.VarChar(120)
  type              BadgeType
  name              String              @db.VarChar(255)
  description       String
  criteriaNarrative String              @map("criteria_narrative")
  externalSource    BadgeExternalSource @map("external_source")
  imageStorageKey   String?             @map("image_storage_key") @db.VarChar(500)
  eventId           String?             @map("event_id") @db.Uuid
  roleCode          String?             @map("role_code") @db.VarChar(50)
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  event      Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assertions BadgeAssertion[]

  @@index([eventId, roleCode])
  @@map("badge_classes")
}

model BadgeAssertion {
  id             String      @id @default(uuid()) @db.Uuid
  uuid           String      @unique @default(uuid()) @db.Uuid
  slug           String      @unique @db.VarChar(16)
  badgeClassId   String      @map("badge_class_id") @db.Uuid
  certificateId  String?     @unique @map("certificate_id") @db.Uuid
  /// Reserved for phase 3 osm_activity. No FK until that table exists.
  osmProfileId   String?     @map("osm_profile_id") @db.Uuid
  recipientName  String      @map("recipient_name") @db.VarChar(255)
  recipientSalt  String      @map("recipient_salt") @db.VarChar(64)
  status         BadgeStatus @default(pending)
  issuedAt       DateTime?   @map("issued_at") @db.Timestamptz(6)
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz(6)
  revokeReason   String?     @map("revoke_reason")
  assertionJson  Json?       @map("assertion_json")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  badgeClass  BadgeClass   @relation(fields: [badgeClassId], references: [id])
  certificate Certificate? @relation(fields: [certificateId], references: [id])

  @@index([badgeClassId])
  @@map("badge_assertions")
}

model InstanceLegal {
  id             String   @id @db.Uuid
  entityName     String   @default("") @map("entity_name") @db.VarChar(255)
  nit            String   @default("") @db.VarChar(50)
  representative String   @default("") @db.VarChar(255)
  issueCity      String   @default("") @map("issue_city") @db.VarChar(255)
  disclaimer     String   @db.VarChar(500)
  lastFolio      Int      @default(0) @map("last_folio")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById    String?  @map("updated_by") @db.Uuid

  updatedBy AdminUser?            @relation("LegalUpdatedBy", fields: [updatedById], references: [id])
  signers   InstanceLegalSigner[]

  @@map("instance_legal")
}

model InstanceLegalSigner {
  id                  String  @id @default(uuid()) @db.Uuid
  instanceLegalId     String  @map("instance_legal_id") @db.Uuid
  slot                Int
  name                String  @db.VarChar(255)
  title               String  @db.VarChar(255)
  signatureStorageKey String? @map("signature_storage_key") @db.VarChar(500)

  instanceLegal InstanceLegal @relation(fields: [instanceLegalId], references: [id], onDelete: Cascade)

  @@unique([instanceLegalId, slot])
  @@map("instance_legal_signers")
}
