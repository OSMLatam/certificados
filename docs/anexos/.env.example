# =============================================================================
# Certificados — environment template
# Copy to .env (local) or inject via Docker Compose / server secrets.
# See docs/10-diseno-codigo-y-anexos.md for full reference.
# =============================================================================

# --- Instance ---
NODE_ENV=development
INSTANCE=osm_lat
# osm_lat | ac3 — controls legal.* palette, osm_activity features, branding defaults

# --- Public URLs ---
PUBLIC_BASE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
# Production examples:
# PUBLIC_BASE_URL=https://certificados.osm.lat
# API_PUBLIC_URL=https://certificados.osm.lat

# --- Database ---
DATABASE_URL=postgresql://certificados:certificados@localhost:5432/certificados?schema=public

# --- Redis (BullMQ — Fase 3 jobs; provision from Fase 1 for simpler compose) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO / S3-compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=certificados
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# --- Auth admin (OAuth OpenStreetMap) ---
SESSION_SECRET=change-me-min-32-chars-random-string-here
SESSION_COOKIE_NAME=cert_session
SESSION_MAX_AGE_MS=86400000
# 86400000 = 24h

# Register OAuth app at https://www.openstreetmap.org/oauth2/applications
OSM_OAUTH_CLIENT_ID=
OSM_OAUTH_CLIENT_SECRET=
OSM_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/admin/auth/osm/callback

# Bootstrap: comma-separated OSM usernames that become admin on first OAuth match
SEED_ADMIN_OSM_USERNAMES=YourOsmUsername
# Optional: comma-separated osm_id (stable); use if usernames may rename before first login
SEED_ADMIN_OSM_IDS=

# --- Branding (instance) ---
SITE_NAME=Certificados OSM Latam
SITE_LOGO_URL=/assets/logo.svg
SITE_FAVICON_URL=/assets/favicon.ico
SITE_PRIMARY_COLOR=#7ebc6f
SITE_FOOTER_TEXT=Comunidad OpenStreetMap Latam

# --- Defaults ---
DEFAULT_COUNTRY_CODE=CO
CSV_DELIMITER=;

# --- Rate limiting (public surfaces — protect shared hosts) ---
# Search: POST /api/v1/public/search
THROTTLE_SEARCH_TTL_MS=60000
THROTTLE_SEARCH_LIMIT=10
# Permalinks: GET /c/*, PDF download, (Fase 2+) /b/*
THROTTLE_PERMALINK_TTL_MS=60000
THROTTLE_PERMALINK_LIMIT=60
# Optional: regex of User-Agents to reject (AI scrapers). Empty = disabled.
# Do not block Badgr, Open Badge Passport, or social OG preview bots.
BLOCKED_BOT_UA_REGEX=

# --- PDF generation (limit Chromium load on the host) ---
PDF_CONCURRENCY=1
PDF_TIMEOUT_MS=30000
PUPPETEER_EXECUTABLE_PATH=
# Leave empty to use bundled Chromium in Docker image

# --- AC3 legal (only when INSTANCE=ac3) ---
LEGAL_ENTITY_NAME=
LEGAL_NIT=
LEGAL_REPRESENTATIVE=
LEGAL_SIGNATURE_FILE=
# LEGAL_SIGNATURE_FILE = storage key, e.g. legal/signatures/signature.png

# --- Open Badges issuer (Fase 2+) ---
OB_ISSUER_NAME=
OB_ISSUER_DESCRIPTION=
OB_ISSUER_IMAGE_KEY=
# Defaults derived from SITE_NAME / LEGAL_* when empty

# --- OSM integration (Fase 3 — osm_lat only) ---
OSM_API_BASE_URL=https://api.openstreetmap.org/api/0.6
OSM_API_USER_AGENT=CertificadosOSMLatam/1.0 (contact@osm.lat)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSM_JOB_CRON=0 3 * * *

# --- Cloudflare Turnstile (Fase 3) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- SMTP optional (Fase 3) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@certificados.osm.lat

# --- Logging ---
LOG_LEVEL=info
# debug | info | warn | error
